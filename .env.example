# Set these as environment variables in the Netlify dashboard
# (Site configuration → Environment variables) — never commit real values.

# Airtable Personal Access Token, scoped to the "Discipline" base
# (appJI9aGVi6MxVK2S) with data.records:read and data.records:write.
# Create one at https://airtable.com/create/tokens
AIRTABLE_API_KEY=

# The Discipline base id (already fixed, shown here for reference).
AIRTABLE_BASE_ID=appJI9aGVi6MxVK2S

# Any long random string — signs the login session tokens.
# Generate one with: openssl rand -hex 32
JWT_SECRET=
